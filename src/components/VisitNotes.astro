---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
---
<div class="visit reveal">
  {/* A shoe inside a shoe cover (the first note): a solid sneaker so it reads at a glance, the cover as a dashed
      outline with a gathered elastic top. Sneaker from Phosphor Icons (MIT). */}
  <svg class="visit__art" viewBox="0 0 160 160" aria-hidden="true" focusable="false">
    <circle cx="80" cy="80" r="77" class="visit__art-bg" />
    <path transform="translate(28 37) scale(.36)" fill="currentColor" d="M228.65,129.11l-28.06-9.35a4,4,0,0,0-2.63,0l-43.23,15.72A8.14,8.14,0,0,1,152,136a8,8,0,0,1-7.71-5.88,8.17,8.17,0,0,1,5.22-9.73L168,113.67a2.54,2.54,0,0,0-.06-4.8,23.93,23.93,0,0,1-8.8-5.25,4,4,0,0,0-4.17-.91l-24.22,8.8a8,8,0,0,1-10.44-5.39,8.17,8.17,0,0,1,5.22-9.73L146,88.93a4,4,0,0,0,2.31-5.34l-3.06-7.16a4,4,0,0,0-5.05-2.19l-25.5,9.27a8,8,0,0,1-10.44-5.39,8.17,8.17,0,0,1,5.22-9.73l24-8.73a4,4,0,0,0,2.31-5.33L130.39,41.6s0-.07,0-.1A16,16,0,0,0,110.25,33L34.53,60.49A16.05,16.05,0,0,0,24,75.53V192a16,16,0,0,0,16,16H240a16,16,0,0,0,16-16V167.06A40,40,0,0,0,228.65,129.11ZM240,192H40V176H240Z" />
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M78 39c8 11 17 20 29 27 11 6 22 11 23 25v22c0 5-3 8-8 8H39c-5 0-8-3-8-8V52" stroke-width="1.8" stroke-dasharray="4.5 4.5" />
      <path d="M31 50c2.6-2.6 5.4 1.6 8-1s5.4 1.6 8-1 5.4 1.6 8-1 5.4 1.6 8-1 5.4 1.6 8-1 4.5 1 7 .6" stroke-width="2" />
    </g>
    <path d="M120 26c.8 4.6 3.4 7.2 8 8-4.6.8-7.2 3.4-8 8-.8-4.6-3.4-7.2-8-8 4.6-.8 7.2-3.4 8-8Z" fill="currentColor" />
  </svg>
  <div>
    <span class="eyebrow">پیش از مراجعه</span>
    <h2 id="visit-title" class="h3" style="margin:10px 0 18px">چند نکته برای یک ویزیت آرام</h2>
    <ul class="notes">
      {site.visitNotes.map((n, i) => (
        <li class={i === 0 ? "is-key" : ""}><Icon name={i === 0 ? "info" : "check"} />{n}</li>
      ))}
    </ul>
  </div>
</div>
