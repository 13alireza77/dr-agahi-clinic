---
import { site, fa } from "../lib/site";
import Icon from "./Icon.astro";
---
<ul class="creds">
  {site.credentials.map((c) => <li><Icon name="check" />{c}</li>)}
</ul>
<div class="irimc">
  <Icon name="shield" class="irimc__ic" />
  <span>نظام پزشکی: <span class="irimc__no">{fa(site.irimc)}</span></span>
  <a href={site.irimcUrl} target="_blank" rel="noopener">استعلام از سامانه‌ی نظام پزشکی</a>
</div>
