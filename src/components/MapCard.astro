---
// Location card: a Neshan map image of the clinic that opens Neshan when tapped. With a Neshan web key in
// site.json, a live Neshan map loads over it once the card scrolls into view. Links open Neshan / Balad / Google Maps.
// The image is src/assets/map/neshan.png, saved from Neshan's static map API (see README), so no key ships with the site.
import { Image } from "astro:assets";
import { site, mapLinks } from "../lib/site";
import neshanMap from "../assets/map/neshan.png";
import Slot from "./Slot.astro";
const key = site.neshanMapKey;
---
<div class="map-card">
  {key && <div class="map-card__live" data-key={key} data-lat={site.geo.lat} data-lng={site.geo.lng} aria-label="نقشه‌ی نشان: محل مطب" role="region"></div>}
  <a class="map-card__art" href={mapLinks.neshan} target="_blank" rel="noopener" aria-label="باز کردن محل مطب در نشان">
    {/* Shown at its natural size and cropped around the pin, so street names stay readable at any card width */}
    <Image src={neshanMap} alt="نقشه‌ی نشان: محل مطب در خیابان کدویی، نزدیک خیابان شریعتی و متروی قلهک" format="webp" quality={85} />
    <span class="map-card__credit">© Neshan © OSM</span>
  </a>
  <div class="map-card__foot">
    <p>{site.building}</p>
    <div class="map-links">
      <a class="is-main" href={mapLinks.neshan} target="_blank" rel="noopener">مسیریابی با نشان</a>
      <a href={mapLinks.balad} target="_blank" rel="noopener">بلد</a>
      <a href={mapLinks.google} target="_blank" rel="noopener">گوگل‌مپ</a>
    </div>
    {!site.neshanUrl && <p style="margin:10px 0 0"><Slot label="لینک اشتراک نشان (nshn.ir)" /></p>}
  </div>
</div>

{key && (
  <script is:inline>
    (() => {
      const el = document.querySelector(".map-card__live");
      if (!el || !("IntersectionObserver" in window)) return;
      const sdk = "https://static.neshan.org/sdk/leaflet/v1.9.4/neshan-sdk/v1.0.8/index";
      const start = () => {
        const css = document.createElement("link");
        css.rel = "stylesheet"; css.href = sdk + ".css";
        document.head.append(css);
        const js = document.createElement("script");
        js.src = sdk + ".js";
        js.onload = () => {
          const at = [+el.dataset.lat, +el.dataset.lng];
          // One-finger drag stays page scroll on phones; the map pans with two fingers or the zoom buttons
          const map = new L.Map(el, {
            key: el.dataset.key, maptype: "neshan", poi: true, traffic: false,
            center: at, zoom: 16, scrollWheelZoom: false, dragging: !L.Browser.mobile,
          });
          L.marker(at).addTo(map).bindPopup("ساختمان پزشکان آرامش").openPopup();
          // Show the map once real tiles arrive. With a wrong key or an unlisted domain, Neshan loads a few real
          // tiles, then clears the map and swaps in blank "tile-empty" images: hide it again and keep the drawing.
          let failed = false;
          const watch = (layer) => layer.on && layer.on("tileload", (t) => {
            if (((t.tile && t.tile.src) || "").includes("tile-empty")) failed = true;
            el.classList.toggle("is-ready", !failed);
          });
          map.eachLayer(watch);
          map.on("layeradd", (e) => watch(e.layer));
        };
        document.head.append(js);
      };
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); }
      }, { rootMargin: "300px" });
      io.observe(el);
    })();
  </script>
)}
