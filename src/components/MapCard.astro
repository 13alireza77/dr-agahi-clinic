---
// Lightweight, schematic location card (no third-party map scripts). Links open Neshan / Balad / Google Maps.
import { site, mapLinks } from "../lib/site";
import Slot from "./Slot.astro";
---
<div class="map-card">
  <svg class="map-card__art" viewBox="0 0 480 330" role="img" aria-label="نقشه‌ی شماتیک: مطب روبه‌روی متروی قلهک">
    <rect width="480" height="330" fill="#efe4d4" />
    <g fill="#e6d6c1">
      <rect x="18" y="20" width="150" height="96" rx="10" /><rect x="18" y="140" width="150" height="70" rx="10" />
      <rect x="18" y="234" width="150" height="80" rx="10" /><rect x="262" y="20" width="96" height="120" rx="10" />
      <rect x="378" y="20" width="86" height="120" rx="10" /><rect x="262" y="198" width="202" height="116" rx="10" />
    </g>
    <g stroke="#fbf7f2" stroke-linecap="round" fill="none">
      <path d="M215 -10 V340" stroke-width="30" />
      <path d="M-10 128 H200 M230 168 H490" stroke-width="14" />
      <path d="M368 0 V150" stroke-width="10" />
    </g>
    <path d="M215 -10 V340" stroke="#d8c4ab" stroke-width="1.5" stroke-dasharray="10 10" />
    <!-- metro -->
    <g transform="translate(150 66)">
      <circle r="17" fill="#6e4636" />
      <text y="6" text-anchor="middle" font-family="Marcellus, serif" font-size="17" fill="#fbf7f2">M</text>
      <text x="0" y="40" text-anchor="middle" font-size="13" font-weight="600" fill="#5b3326" direction="rtl">متروی قلهک</text>
    </g>
    <!-- clinic -->
    <g transform="translate(300 116)">
      <circle r="30" fill="#6e4636" opacity=".12"><animate attributeName="r" values="18;34;18" dur="3s" repeatCount="indefinite" /><animate attributeName="opacity" values=".25;0;.25" dur="3s" repeatCount="indefinite" /></circle>
      <path d="M0 8s-15-13-15-25a15 15 0 0 1 30 0C15-5 0 8 0 8Z" fill="#3a1a08" transform="translate(0 -6)" />
      <circle cy="-23" r="5.5" fill="#fbf7f2" />
      <rect x="-56" y="12" width="112" height="28" rx="14" fill="#fbf7f2" />
      <text y="31" text-anchor="middle" font-size="12.5" font-weight="700" fill="#3a1a08" direction="rtl">ساختمان پزشکان آرامش</text>
    </g>
    <text x="466" y="318" text-anchor="start" font-size="10" fill="#9b7c62" direction="rtl">نقشه‌ی شماتیک</text>
  </svg>
  <div class="map-card__foot">
    <p>{site.building}</p>
    <div class="map-links">
      {mapLinks.neshan && <a href={mapLinks.neshan} target="_blank" rel="noopener">نشان</a>}
      <a href={mapLinks.balad} target="_blank" rel="noopener">بلد</a>
      <a href={mapLinks.google} target="_blank" rel="noopener">گوگل‌مپ</a>
    </div>
    {!mapLinks.neshan && <p style="margin:10px 0 0"><Slot label="لینک اشتراک نشان (nshn.ir)" /></p>}
  </div>
</div>
