---
import Base from "../layouts/Base.astro";
import PalmShadow from "../components/PalmShadow.astro";
import Icon from "../components/Icon.astro";
import { site, link } from "../lib/site";
---
<Base title="صفحه پیدا نشد | دکتر صدف آگاهی" description="صفحه‌ای که دنبالش بودید پیدا نشد." noindex>
  <section class="hero" style="min-height:60vh;display:grid;place-items:center">
    <PalmShadow seed={4} />
    <div class="container cta-band" style="position:relative;z-index:1">
      <span class="hero__latin wordmark-latin">{site.wordmark}</span>
      <h1 class="h2">این صفحه پیدا نشد</h1>
      <p class="muted">ممکن است نشانی تغییر کرده باشد. از صفحه‌ی اصلی ادامه دهید یا نوبت بگیرید.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={link("/")}>صفحه‌ی اصلی</a>
        <a class="btn btn--ghost" href={link("/booking/")}>رزرو نوبت <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>
